//   DEVELOPMENT_TEAM = SEUTEAMID
// assinando com a mesma identidade, o macOS lembra as permissões de câmera e microfone entre builds
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
